{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Strict */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
   * Папки проверок исключены целиком, а не по маске `*.test.ts`. Рядом с
   * тестами живут их собственные вспомогательные модули — определения канона,
   * поиск соседних деревьев, — и они читают файлы через `node:fs`. Под
   * конфигом приложения типов Node нет и быть не должно: приложение работает
   * в браузере. Помощник теста, попавший в сборку приложения, ронял типы.
   */
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**", "src/sim/**"]
}
