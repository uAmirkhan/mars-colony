<!--
  Защита от обрезки кода при сборке через IL2CPP (веб и мобильные платформы).
  Newtonsoft разбирает сейв через рефлексию: статических ссылок на типы снимка
  в коде нет, и обрезчик их выбрасывает. Ломается не сборка, а загрузка
  сохранения уже в браузере, без единой ошибки при компиляции.
-->
<linker>
  <assembly fullname="Newtonsoft.Json" preserve="all" />
  <assembly fullname="Assembly-CSharp" preserve="all" />
</linker>
