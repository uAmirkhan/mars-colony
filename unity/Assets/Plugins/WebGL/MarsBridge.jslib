// Мост «плеер -> страница». Единственная задача: положить сводку плеера туда,
// где ее увидит браузерная проверка.
//
// Внутри канваса Unity нет DOM, поэтому проверке играбельности не за что
// зацепиться: она не знает ни где объекты, ни что с ними стало. Плагин ничего
// не решает и ничего не рисует — он только перекладывает строку в window.
//
// Разбор JSON делается здесь, а не на стороне проверки: если плеер однажды
// пришлет мусор, поле `error` покажет это сразу, а не превратится в загадочное
// падение проверки на разборе.

mergeInto(LibraryManager.library, {
  MarsPublish: function (ptr) {
    var json = UTF8ToString(ptr);
    try {
      window.marsColony = JSON.parse(json);
    } catch (e) {
      window.marsColony = { ready: false, error: String(e), raw: json };
    }
  },
});
